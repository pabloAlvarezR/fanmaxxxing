<UserControl x:Class="FanMaxxxing.UI.FanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Width="400" Height="400" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" />
                    <TranslateTransform x:Name="RootShake" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Halo -->
            <Ellipse Width="400" Height="400">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowInner" Color="#5522D3EE" Offset="0.6" />
                        <GradientStop x:Name="GlowOuter" Color="#0022D3EE" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Anillo de progreso -->
            <Ellipse Width="378" Height="378" Stroke="#18FFFFFF" StrokeThickness="9" />
            <Canvas Width="400" Height="400">
                <Path x:Name="ProgressArc" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22D3EE" Offset="0" />
                            <GradientStop Color="#7C5CFF" Offset="0.5" />
                            <GradientStop Color="#FF2E88" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Canvas>

            <!-- Carcasa -->
            <Ellipse Width="352" Height="352" Fill="#0D1227" Stroke="#39437A" StrokeThickness="4" />
            <Ellipse Width="300" Height="300" Stroke="#10FFFFFF" StrokeThickness="2" />
            <Ellipse Width="240" Height="240" Stroke="#0CFFFFFF" StrokeThickness="2" />

            <!-- Desenfoque de movimiento -->
            <Ellipse x:Name="BlurDisc" Width="336" Height="336" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="BlurInner" Color="#AA3B82F6" Offset="0.35" />
                        <GradientStop x:Name="BlurMid" Color="#663B82F6" Offset="0.8" />
                        <GradientStop Color="#003B82F6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Aspas (se generan en código) -->
            <Canvas x:Name="BladeCanvas" Width="400" Height="400">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BladeRotate" CenterX="200" CenterY="200" />
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Buje con cara -->
            <Ellipse Width="132" Height="132" Stroke="#66FFFFFF" StrokeThickness="3">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop x:Name="HubLight" Color="#FFF3B0" Offset="0" />
                        <GradientStop x:Name="HubDark" Color="#FF9F1C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas Width="128" Height="128">
                <Ellipse x:Name="BlushL" Canvas.Left="26" Canvas.Top="68" Width="16" Height="9" Fill="#FF6B9A" Opacity="0" />
                <Ellipse x:Name="BlushR" Canvas.Left="86" Canvas.Top="68" Width="16" Height="9" Fill="#FF6B9A" Opacity="0" />
                <Path x:Name="EyeL" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path x:Name="EyeR" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Ellipse x:Name="ShineL" Width="5" Height="5" Fill="White" Canvas.Left="41" Canvas.Top="49" />
                <Ellipse x:Name="ShineR" Width="5" Height="5" Fill="White" Canvas.Left="77" Canvas.Top="49" />
                <Path x:Name="Mouth" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path x:Name="Sweat" Fill="#7DF9FF" Opacity="0" Data="M 0,0 C 4,7 7,10 7,14 A 7,7 0 1 1 -7,14 C -7,10 -4,7 0,0 Z">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="SweatPos" X="104" Y="20" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <TextBlock x:Name="Zzz" Text="z Z z" FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="34"
                       Foreground="#C7D2FE" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ZzzPos" X="90" Y="-90" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
