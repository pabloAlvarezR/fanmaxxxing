<UserControl x:Class="FanMaxxxing.UI.FanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Width="400" Height="400" RenderTransformOrigin="0.5,0.5" Margin="24">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootShake" />
            </Grid.RenderTransform>

            <!-- Resplandor ambiente (color según temperatura) -->
            <Ellipse Width="470" Height="470" Margin="-35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowInner" Color="#3022D3EE" Offset="0.55" />
                        <GradientStop x:Name="GlowOuter" Color="#0022D3EE" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Marco de 120 mm -->
            <Rectangle Width="388" Height="388" RadiusX="46" RadiusY="46" StrokeThickness="1.5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A3042" Offset="0" />
                        <GradientStop Color="#161A26" Offset="0.55" />
                        <GradientStop Color="#0E1119" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5A6380" Offset="0" />
                        <GradientStop Color="#1C2130" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>
            <Rectangle Width="378" Height="378" RadiusX="41" RadiusY="41" Stroke="#0DFFFFFF" StrokeThickness="1" />

            <!-- Tornillos con almohadilla antivibración -->
            <Canvas Width="400" Height="400">
                <Canvas.Resources>
                    <Style TargetType="Ellipse" x:Key="Pad">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Fill" Value="#0E1018" />
                        <Setter Property="Stroke" Value="#262B3A" />
                        <Setter Property="StrokeThickness" Value="5" />
                    </Style>
                    <Style TargetType="Ellipse" x:Key="Hole">
                        <Setter Property="Width" Value="14" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="Fill" Value="#030406" />
                    </Style>
                </Canvas.Resources>
                <Ellipse Style="{StaticResource Pad}" Canvas.Left="21" Canvas.Top="21" />
                <Ellipse Style="{StaticResource Pad}" Canvas.Left="345" Canvas.Top="21" />
                <Ellipse Style="{StaticResource Pad}" Canvas.Left="21" Canvas.Top="345" />
                <Ellipse Style="{StaticResource Pad}" Canvas.Left="345" Canvas.Top="345" />
                <Ellipse Style="{StaticResource Hole}" Canvas.Left="31" Canvas.Top="31" />
                <Ellipse Style="{StaticResource Hole}" Canvas.Left="355" Canvas.Top="31" />
                <Ellipse Style="{StaticResource Hole}" Canvas.Left="31" Canvas.Top="355" />
                <Ellipse Style="{StaticResource Hole}" Canvas.Left="355" Canvas.Top="355" />
            </Canvas>

            <!-- Pista y arco de progreso -->
            <Ellipse Width="374" Height="374" Stroke="#10FFFFFF" StrokeThickness="3" />
            <Canvas Width="400" Height="400">
                <Path x:Name="ProgressArc" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E0F7FF" Offset="0" />
                            <GradientStop Color="#22D3EE" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Canvas>

            <!-- Abertura del ventilador con bisel -->
            <Ellipse Width="360" Height="360" StrokeThickness="4">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0A0C13" Offset="0" />
                        <GradientStop Color="#05060A" Offset="0.85" />
                        <GradientStop Color="#11141D" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#05060A" Offset="0" />
                        <GradientStop Color="#454D68" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <!-- Anillo RGB (resplandor + línea) -->
            <Grid x:Name="RingGroup">
                <Ellipse Width="352" Height="352" StrokeThickness="10" Opacity="0.75">
                    <Ellipse.Stroke>
                        <LinearGradientBrush x:Name="RingGlowBrush" StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="RingGlowSpin" CenterX="0.5" CenterY="0.5" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop x:Name="RingGlowA" Color="#22D3EE" Offset="0" />
                            <GradientStop x:Name="RingGlowB" Color="#7C5CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.Effect>
                        <BlurEffect Radius="16" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="352" Height="352" StrokeThickness="3">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="RingSpin" CenterX="0.5" CenterY="0.5" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop x:Name="RingA" Color="#22D3EE" Offset="0" />
                            <GradientStop x:Name="RingB" Color="#7C5CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
            </Grid>

            <!-- Brazos del soporte del motor (detrás de las aspas) -->
            <Path x:Name="Struts" Stroke="#1B2030" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <!-- Desenfoque de movimiento -->
            <Ellipse x:Name="BlurDisc" Width="344" Height="344" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00303848" Offset="0.3" />
                        <GradientStop x:Name="BlurInner" Color="#7A303848" Offset="0.38" />
                        <GradientStop x:Name="BlurMid" Color="#66303848" Offset="0.93" />
                        <GradientStop Color="#00303848" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Rotor (las aspas se generan en código) -->
            <Canvas x:Name="BladeCanvas" Width="400" Height="400">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BladeRotate" CenterX="200" CenterY="200" />
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Brillo especular fijo: al girar las aspas por debajo da sensación de plástico real -->
            <Ellipse Width="344" Height="344">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.22" Center="0.36,0.3" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#22FFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Buje del motor con display -->
            <Ellipse Width="120" Height="120" StrokeThickness="2">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.25">
                        <GradientStop Color="#3D445B" Offset="0" />
                        <GradientStop Color="#1A1E2B" Offset="0.7" />
                        <GradientStop Color="#10131C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6A7393" Offset="0" />
                        <GradientStop Color="#1C2130" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse Width="94" Height="94" Fill="#0B0D14" StrokeThickness="1.5">
                <Ellipse.Stroke>
                    <SolidColorBrush x:Name="HubRingBrush" Color="#22D3EE" Opacity="0.7" />
                </Ellipse.Stroke>
            </Ellipse>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock x:Name="HubMain" Text="AUTO" FontFamily="Bahnschrift, Segoe UI" FontSize="27" FontWeight="SemiBold"
                           Foreground="#EEF1FF" HorizontalAlignment="Center" />
                <TextBlock x:Name="HubSub" Text="" FontFamily="Bahnschrift, Segoe UI" FontSize="10.5"
                           Foreground="#8D97C0" HorizontalAlignment="Center" Margin="0,-2,0,0" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
