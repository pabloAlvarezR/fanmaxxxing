<Window x:Class="FanMaxxxing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FanMaxxxing.UI"
        Title="FanMaxxxing" Width="1120" Height="740" MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/fan.ico" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BgStop0" Color="#0A0D1A" Offset="0" />
                <GradientStop x:Name="BgStop1" Color="#141A3A" Offset="0.55" />
                <GradientStop x:Name="BgStop2" Color="#2A0F2E" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ui:ParticleLayer x:Name="Particles" />

        <Grid x:Name="ContentGrid">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShakeTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título ===== -->
            <Grid Grid.Row="0" Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/fan.ico" Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="LogoSpin" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource NumFont}" FontSize="22" FontWeight="Bold">
                        <Run Text="FAN" Foreground="{StaticResource Text}" /><Run Text="MAXXXING" Foreground="{StaticResource Cyan}" />
                    </TextBlock>
                    <Border Margin="12,2,0,0" VerticalAlignment="Center" CornerRadius="6" Padding="7,2" Background="#22FF2E88">
                        <TextBlock Text="enfriador post-vicio" FontSize="11" Foreground="{StaticResource Magenta}" />
                    </Border>
                    <Border x:Name="SimBadge" Margin="8,2,0,0" VerticalAlignment="Center" CornerRadius="6" Padding="7,2" Background="#33FFD60A" Visibility="Collapsed">
                        <TextBlock Text="SIMULACIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Yellow}" />
                    </Border>
                    <Border x:Name="NoAdminBadge" Margin="8,2,0,0" VerticalAlignment="Center" CornerRadius="6" Padding="7,2" Background="#33FF4D5E" Visibility="Collapsed"
                            ToolTip="Sin permisos de administrador: FanControl puede pedir permiso y la temperatura de la CPU no se podrá leer.">
                        <TextBlock Text="SIN ADMIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Danger}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SoundButton" Style="{StaticResource ChromeButton}" FontSize="15" Content="&#xE767;" ToolTip="Sonido"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="SoundButton_Click" />
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" FontSize="15" Content="&#xE713;" ToolTip="Ajustes"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="SettingsButton_Click" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimizar"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Cerrar"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== Cuerpo ===== -->
            <Grid Grid.Row="1" Margin="18,4,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <!-- Escenario del meme -->
                <Border Grid.Column="0" CornerRadius="22" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Background="#66070A16" ClipToBounds="True">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:OutlinedText x:Name="TopCaption" Grid.Row="0" FontSize="36" Text="FAN MAXXXING" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Stretch">
                            <ui:OutlinedText.RenderTransform>
                                <ScaleTransform x:Name="TopCaptionScale" />
                            </ui:OutlinedText.RenderTransform>
                        </ui:OutlinedText>
                        <ui:FanView x:Name="Fan" Grid.Row="1" Margin="10" />
                        <ui:OutlinedText x:Name="BottomCaption" Grid.Row="2" FontSize="36" Text="CARGANDO MEMES" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Stretch">
                            <ui:OutlinedText.RenderTransform>
                                <ScaleTransform x:Name="BottomCaptionScale" />
                            </ui:OutlinedText.RenderTransform>
                        </ui:OutlinedText>
                    </Grid>
                </Border>

                <!-- Panel de control -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TempCard x:Name="CpuCard" Grid.Column="0" Title="CPU" />
                        <ui:TempCard x:Name="GpuCard" Grid.Column="2" Title="GPU" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,10,18,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="TimerText" Text="05:00" FontFamily="{StaticResource NumFont}" FontSize="62" FontWeight="SemiBold" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="RpmText" Text="" FontFamily="{StaticResource NumFont}" FontSize="22" HorizontalAlignment="Right" Foreground="{StaticResource Cyan}" />
                                    <TextBlock x:Name="RpmLabel" Text="" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource TextFaint}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="Listo para maxxear." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextDim}" MinHeight="36" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="2,16,0,0">
                        <TextBlock Text="DURACIÓN" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="DurationPanel">
                            <RadioButton Style="{StaticResource Pill}" GroupName="dur" Content="3 min" Tag="3" Checked="Duration_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="dur" Content="4 min" Tag="4" Checked="Duration_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="dur" Content="5 min" Tag="5" Checked="Duration_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="dur" Content="7 min" Tag="7" Checked="Duration_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="dur" Content="10 min" Tag="10" Checked="Duration_Checked" />
                        </WrapPanel>

                        <TextBlock Text="AL TERMINAR" Style="{StaticResource SectionTitle}" Margin="0,10,0,8" />
                        <WrapPanel x:Name="AfterPanel">
                            <RadioButton Style="{StaticResource Pill}" GroupName="after" Content="Nada, sigo con el PC" Tag="Nothing" Checked="After_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="after" Content="Apagar" Tag="Shutdown" Checked="After_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="after" Content="Hibernar" Tag="Hibernate" Checked="After_Checked" />
                            <RadioButton Style="{StaticResource Pill}" GroupName="after" Content="Suspender" Tag="Sleep" Checked="After_Checked" />
                        </WrapPanel>

                        <CheckBox x:Name="SmartStopCheck" Style="{StaticResource Switch}" Margin="0,10,0,0" Click="SmartStopCheck_Click">
                            <TextBlock x:Name="SmartStopText" TextWrapping="Wrap" Text="Parar antes si ya está todo frío" />
                        </CheckBox>
                    </StackPanel>

                    <!-- Botón gordo -->
                    <Button x:Name="MainButton" Grid.Row="3" Height="96" Margin="0,10,0,0" Cursor="Hand" Click="MainButton_Click" RenderTransformOrigin="0.5,0.5"
                            Background="{StaticResource NeonGradient}">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="MainButtonScale" />
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Glow" CornerRadius="24" Background="{TemplateBinding Background}" Opacity="0.45" Margin="6,10,6,-6">
                                        <Border.Effect>
                                            <BlurEffect Radius="24" />
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="Bd" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="#55FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Hover" CornerRadius="22" Background="White" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                                        <Setter TargetName="Glow" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Hover" Property="Opacity" Value="0.18" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock x:Name="MainButtonText" Text="MAXXEAR" FontFamily="{StaticResource MemeFont}" FontSize="38" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainButtonSub" Text="ventiladores al 100 %" FontSize="13" Foreground="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Pie ===== -->
            <Grid Grid.Row="2" Margin="20,0,20,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextFaint}" />
                    <TextBlock x:Name="BackendTitle" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" Text="Comprobando motor…" />
                    <TextBlock x:Name="BackendDetail" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="RANGO " FontSize="12" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource NumFont}" />
                    <TextBlock x:Name="RankText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Yellow}" FontFamily="{StaticResource NumFont}" />
                    <TextBlock x:Name="RankNext" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Palabras doge ===== -->
        <Canvas x:Name="DogeCanvas" IsHitTestVisible="False" />

        <!-- ===== Texto flash ===== -->
        <ui:OutlinedText x:Name="FlashText" FontSize="72" Text="" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                         Margin="40,0" RenderTransformOrigin="0.5,0.5">
            <ui:OutlinedText.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FlashScale" />
                    <RotateTransform Angle="-6" />
                </TransformGroup>
            </ui:OutlinedText.RenderTransform>
        </ui:OutlinedText>

        <!-- ===== Toast (logros / avisos) ===== -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0" CornerRadius="18" Padding="18,12,22,12"
                Background="#F2151B33" BorderThickness="2" Opacity="0" IsHitTestVisible="False" MaxWidth="640" Panel.ZIndex="10">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="ToastBorderA" Color="#22D3EE" Offset="0" />
                    <GradientStop x:Name="ToastBorderB" Color="#FF2E88" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="🏆" FontFamily="Segoe UI Emoji" FontSize="34" Foreground="{StaticResource Yellow}" VerticalAlignment="Center" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitle" FontFamily="{StaticResource NumFont}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Cuenta atrás de apagado ===== -->
        <Grid x:Name="PowerOverlay" Visibility="Collapsed" Background="#EB05070F">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="86" Foreground="{StaticResource Yellow}" HorizontalAlignment="Center" />
                <ui:OutlinedText x:Name="PowerTitle" FontSize="48" Text="BUENAS NOCHES, GAMER" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="PowerSub" Text="El equipo se apagará en" FontSize="18" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock x:Name="PowerCount" Text="30" FontFamily="{StaticResource NumFont}" FontSize="132" FontWeight="Bold" Foreground="{StaticResource Text}"
                           HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="PowerCountScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="PowerHint" Text="Los ventiladores ya han vuelto a automático." FontSize="13" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PowerCancelButton" Style="{StaticResource GhostButton}" FontSize="16" Padding="22,12" Click="PowerCancel_Click"
                            Background="#33FF2E88" BorderBrush="{StaticResource Magenta}">
                        <TextBlock Text="¡QUIETO! Sigo despierto" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="PowerNowButton" Style="{StaticResource GhostButton}" FontSize="16" Padding="22,12" Margin="14,0,0,0" Click="PowerNow_Click">
                        <TextBlock x:Name="PowerNowText" Text="Hazlo ya" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
