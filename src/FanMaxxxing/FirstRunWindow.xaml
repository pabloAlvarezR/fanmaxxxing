<Window x:Class="FanMaxxxing.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FanMaxxxing" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/fan.ico"
        Background="#0D1124" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#2B3560" BorderThickness="1">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0C1E3E" Offset="0" />
                    <GradientStop Color="#0D1124" Offset="0.6" />
                    <GradientStop Color="#2A0F2E" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Margin="34,26,34,30">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/fan.ico" Width="40" Height="40" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource NumFont}" FontSize="30" FontWeight="Bold">
                        <Run Text="FAN" /><Run Text="MAXXXING" Foreground="{StaticResource Cyan}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="TitleText" Margin="0,18,0,0" FontFamily="{StaticResource NumFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />

                <TextBlock x:Name="LanguageLabel" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                <WrapPanel x:Name="LanguagePanel" />

                <TextBlock x:Name="SoundLabel" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                <TextBlock x:Name="SoundHint" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="SoundOn" Style="{StaticResource Pill}" GroupName="snd" Padding="14,14" Margin="0,0,8,0" FontSize="15" Checked="Sound_Checked" />
                    <RadioButton x:Name="SoundOff" Style="{StaticResource Pill}" GroupName="snd" Padding="14,14" Margin="8,0,0,0" FontSize="15" Checked="Sound_Checked" />
                </UniformGrid>

                <Button x:Name="ContinueButton" Style="{StaticResource GhostButton}" Margin="0,26,0,0" Padding="18,12" HorizontalAlignment="Right"
                        IsEnabled="False" Background="{StaticResource NeonGradient}" BorderBrush="Transparent" Click="Continue_Click">
                    <TextBlock x:Name="ContinueText" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
