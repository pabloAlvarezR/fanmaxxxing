<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FanMaxxxing</AssemblyName>
    <RootNamespace>FanMaxxxing</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fan.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>FanMaxxxing</Product>
    <Description>Post-gaming PC cooler: fans to max, then shut down with no residual heat.</Description>
    <Copyright>FanMaxxxing</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\fan.ico" />
    <!-- Idiomas: Strings\<código>.json -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="FanMaxxxing.Strings.%(Filename).json" />
  </ItemGroup>

  <!-- Main propio (Program.cs): App.xaml deja de generar el suyo -->
  <PropertyGroup>
    <StartupObject>FanMaxxxing.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
