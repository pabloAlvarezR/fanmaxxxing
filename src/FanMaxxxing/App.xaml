<Application x:Class="FanMaxxxing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Paleta ===== -->
            <Color x:Key="Bg0Color">#0A0D1A</Color>
            <Color x:Key="Bg1Color">#121833</Color>
            <Color x:Key="CardColor">#151B33</Color>
            <Color x:Key="CyanColor">#22D3EE</Color>
            <Color x:Key="MagentaColor">#FF2E88</Color>
            <Color x:Key="OrangeColor">#FF6B35</Color>
            <Color x:Key="YellowColor">#FFD60A</Color>
            <Color x:Key="LimeColor">#A3FF12</Color>

            <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
            <SolidColorBrush x:Key="Card" Color="#CC151B33" />
            <SolidColorBrush x:Key="CardSolid" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardBorder" Color="#2B3560" />
            <SolidColorBrush x:Key="Text" Color="#EEF1FF" />
            <SolidColorBrush x:Key="TextDim" Color="#8D97C0" />
            <SolidColorBrush x:Key="TextFaint" Color="#5A6390" />
            <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
            <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}" />
            <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}" />
            <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
            <SolidColorBrush x:Key="Lime" Color="{StaticResource LimeColor}" />
            <SolidColorBrush x:Key="Danger" Color="#FF4D5E" />

            <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#7C5CFF" Offset="0.5" />
                <GradientStop Color="#FF2E88" Offset="1" />
            </LinearGradientBrush>

            <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MemeFont">Impact, Arial Black, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- ===== Botones de la barra de título ===== -->
            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Botón secundario ===== -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Pastillas seleccionables (RadioButton) ===== -->
            <Style x:Key="Pill" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#2BFFFFFF" BorderThickness="1"
                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NeonGradient}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Interruptor (CheckBox) ===== -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" Background="#2A3157"
                                        BorderBrush="#3D4878" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#AEB6DA" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource NeonGradient}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                    <Setter TargetName="Knob" Property="Fill" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Caja de texto oscura ===== -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Background" Value="#0D1226" />
                <Setter Property="BorderBrush" Value="#2B3560" />
                <Setter Property="CaretBrush" Value="{StaticResource Cyan}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Cyan}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Slider ===== -->
            <Style x:Key="SliderRepeat" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NeonSlider" TargetType="Slider">
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="22">
                                <Border Height="6" CornerRadius="3" Background="#2A3157" VerticalAlignment="Center" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="16" Height="16" Fill="{StaticResource NeonGradient}" Stroke="White" StrokeThickness="2" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Tooltip ===== -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#1C2344" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="BorderBrush" Value="#3D4878" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <!-- ===== Scrollbar fina ===== -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3D4878" Margin="1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
